# Left out, a development-only key is used. Set a long random one in production
# (an empty SECRET_KEY= line would stop Django from starting).
# SECRET_KEY=
# Off unless set to True. Keep it True locally, never in production.
DEBUG=True

# Comma-separated. On Render, the service's own domain is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated URLs of the frontend(s) allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_NAME=science-nest
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# The Next.js site. Links in emails (e.g. password reset) point here.
FRONTEND_DOMAIN=localhost:3000
FRONTEND_PROTOCOL=http

# Email. Leave EMAIL_HOST empty to print emails in the dev server's terminal
# instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# The sender shown on emails, e.g. Science Nest <no-reply@example.com>.
# Left empty, it is Science Nest <webmaster@localhost>.
DEFAULT_FROM_EMAIL=
